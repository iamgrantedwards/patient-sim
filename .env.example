# LiveKit Cloud — one account covers the room, the SIP trunk, and Inference.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Twilio Elastic SIP Trunk, registered with LiveKit as an outbound trunk.
SIP_OUTBOUND_TRUNK_ID=ST_

# The ONLY number this bot is permitted to dial.
TARGET_NUMBER=+18054398008
# Our single DID. This exact string goes on the submission form.
CALLER_ID=+1

# Pipeline defaults. Record any experimental change; comparison is currently deferred.
STT_MODEL=deepgram/flux-general-en
STT_LANGUAGE=en
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=cartesia/sonic-3.6
TTS_VOICE=

# Turn detection. "stt" uses Flux's semantic endpointing; "vad" is the fallback.
TURN_DETECTION=stt
ENDPOINTING_MODE=dynamic
ENDPOINTING_MIN_DELAY=0.4
ENDPOINTING_MAX_DELAY=6.0

# Failsafes against two polite bots looping forever.
MAX_CALL_SECONDS=240
MAX_TURNS=40
RINGING_TIMEOUT_SECONDS=30

# Judge only, via existing LiveKit credentials. Never on the call path.
JUDGE_MODEL=gpt-4.1
