    {
      "idx": 8,
      "item_id": "item_6bd70e571635",
      "role": "remote",
      "text": "For a refill request, it helps to have the medication name, your pharmacy details, and your date of birth. The prescription number is helpful but not required. If our office can't handle the refill, you can contact your pharmacy directly. They can often reach out to your provider for you.",
      "status": "completed",
      "interrupted": false,
      "event_received_at": 1789868083.956851,
      "audio_start_ms": null,
